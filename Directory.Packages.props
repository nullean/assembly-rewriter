<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the tool -->
  <ItemGroup>
    <PackageVersion Include="ILRepack.Lib" Version="2.0.18" />
    <PackageVersion Include="MinVer" Version="4.3.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.3" />
    <PackageVersion Include="Nullean.Argh" Version="0.18.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <PackageVersion Include="Argu" Version="6.0.0" />
    <PackageVersion Include="Bullseye" Version="3.3.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="5.15.0" />
    <!-- under CPM the F# SDK adds no implicit FSharp.Core; this is the one the SDK resolved before -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Proc" Version="0.14.0" />
    <PackageVersion Include="Proc.Fs" Version="0.14.0" />
  </ItemGroup>
</Project>
