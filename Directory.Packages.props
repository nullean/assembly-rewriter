<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the tool -->
  <ItemGroup>
    <PackageVersion Include="ILRepack.Lib" Version="2.0.18" />
    <PackageVersion Include="MinVer" Version="4.3.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.3" />
    <PackageVersion Include="Nullean.Argh" Version="0.18.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- Nullean.Make.Fs needs 11.0.100 or later; this is the one the SDK resolved before -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Nullean.Make.Fs" Version="0.25.0" />
    <!-- the current release, which Nullean.Make.Fs would otherwise resolve at its 0.17.0 floor -->
    <PackageVersion Include="Proc.Fs" Version="0.18.0" />
  </ItemGroup>
</Project>
